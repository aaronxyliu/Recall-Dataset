{
  "name": "@futo-org/backups-orchestrator-ui",
  "repository": "https://github.com/futo-org/backups",
  "description": "Backups orchestrator (UI library)",
  "version": "1.12.1",
  "license": "Source First License 1.1",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/fetch-client.d.ts",
      "default": "./dist/fetch-client.js"
    }
  },
  "peerDependencies": {
    "@immich/ui": "^0.90.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@immich/ui": "^0.90.0",
    "@lingui/cli": "^5.8.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/d3": "^7.4.3",
    "@types/lodash.debounce": "^4.0.9",
    "@types/luxon": "^3.7.6",
    "@vitest/browser-playwright": "^5.0.0",
    "oazapfts": "^7.5.0",
    "playwright": "1.63.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.25",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.0",
    "vitest-browser-svelte": "^3.1.0"
  },
  "keywords": [
    "svelte"
  ],
  "dependencies": {
    "@lingui/core": "^5.8.0",
    "@material-symbols/svg-400": "^0.48.1",
    "@mdi/js": "^7.4.47",
    "@oazapfts/runtime": "^1.2.0",
    "@tanstack/svelte-query": "^6.3.1",
    "cron-validate": "^1.5.3",
    "cronstrue": "^3.27.0",
    "lodash.debounce": "^4.0.8",
    "luxon": "^3.7.2",
    "socket.io-client": "^4.8.3",
    "svelte-i18n-lingui": "^0.2.2",
    "@futo-org/backups-api-client": "^1.12.1"
  },
  "scripts": {
    "dev": "vite dev --port 5174",
    "build": "npm run lingui:compile && vite build && npm run prepack",
    "preview": "vite preview --port 4174",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest --run",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:create": "playwright codegen http://localhost:36066",
    "generate:fetch-client": "oazapfts --optimistic ../orchestration-api/openapi-specs.json src/lib/fetch-client.ts",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile --typescript"
  }
}