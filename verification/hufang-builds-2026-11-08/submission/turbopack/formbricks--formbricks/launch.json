{
  "containerPort": 3000,
  "route": "/setup/signup",
  "expectedSelector": "form",
  "expectedText": "Create administrator|Create an administrator|Email",
  "scopeNotes": [
    "First installation with a fresh local database. Chromium verifies the administrator sign-up form without submitting it."
  ],
  "composeFile": "compose.yaml",
  "composeWaitSeconds": 600,
  "readinessTimeoutSeconds": 360,
  "generateEnvironment": [
    "POSTGRES_PASSWORD",
    "BETTER_AUTH_SECRET",
    "CRON_SECRET",
    "AUTHZED_TOKEN",
    "AUTHZED_DATABASE_PASSWORD",
    "HUB_API_KEY",
    "CUBEJS_API_SECRET"
  ],
  "generateHexEnvironment": {
    "ENCRYPTION_KEY": 32
  },
  "environmentTemplates": {
    "WEBAPP_URL": "http://127.0.0.1:{port}",
    "BETTER_AUTH_URL": "http://127.0.0.1:{port}",
    "DATABASE_URL": "postgresql://postgres:{POSTGRES_PASSWORD}@postgres:5432/formbricks?schema=public",
    "REDIS_URL": "redis://redis:6379",
    "AUTHZED_ENABLED": "true",
    "AUTHZED_ENDPOINT": "spicedb:50051",
    "AUTHZED_TOKEN": "{AUTHZED_TOKEN}",
    "AUTHZED_SYSTEM_KEY": "formbricks",
    "AUTHZED_CONSISTENCY": "fully_consistent",
    "AUTHZED_INSECURE": "true",
    "HUB_API_URL": "http://hub:8080",
    "CUBEJS_API_URL": "http://cube:4000"
  }
}
