{
  "containerPort": 3000,
  "route": "/",
  "expectedSelector": "main, form",
  "expectedText": "Cap|Sign in",
  "composeFile": "compose.yaml",
  "composeWaitSeconds": 480,
  "readinessTimeoutSeconds": 240,
  "generateEnvironment": [
    "MYSQL_PASSWORD",
    "MYSQL_ROOT_PASSWORD",
    "MINIO_ROOT_PASSWORD",
    "NEXTAUTH_SECRET",
    "MEDIA_SERVER_WEBHOOK_SECRET"
  ],
  "generateHexEnvironment": {
    "DATABASE_ENCRYPTION_KEY": 32
  },
  "environmentTemplates": {
    "CAP_URL": "http://127.0.0.1:{port}",
    "S3_PUBLIC_URL": "http://127.0.0.1:43210"
  },
  "scopeNotes": [
    "Self-hosted landing/login scope. Recording upload, email and media processing actions are outside this observation."
  ]
}
