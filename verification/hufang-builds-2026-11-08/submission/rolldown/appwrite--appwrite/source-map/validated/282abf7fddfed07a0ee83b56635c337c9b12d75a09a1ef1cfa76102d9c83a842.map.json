{"version":3,"file":"DatabaseSidebarTableSearch-DDkSbHJn.js","names":[],"sources":["../../../src/components/pages/projects/$projectId/databases/_components/DatabaseSidebarTableSearch.tsx"],"sourcesContent":["import { Button } from '@/components/ui/button'\nimport {\n  DropdownMenu,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu'\nimport { Input } from '@/components/ui/input'\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from '@/components/ui/tooltip'\nimport { useT } from '@/lib/i18n/translate'\nimport { cn } from '@/lib/utils'\nimport { ArrowUpDown, RefreshCw, Search, X } from 'lucide-react'\nimport type { ReactNode } from 'react'\n\ntype DatabaseSidebarTableSearchProps = {\n  value: string\n  onChange: (value: string) => void\n  placeholder: string\n  ariaLabel?: string\n  disabled?: boolean\n  clearAriaLabel?: string\n  isFetching?: boolean\n  onRefresh?: () => void\n  sortAriaLabel: string\n  sortTooltip?: string\n  sortDisabled?: boolean\n  sortMenu: ReactNode\n  className?: string\n}\n\nexport function DatabaseSidebarTableSearch({\n  value,\n  onChange,\n  placeholder,\n  ariaLabel,\n  disabled = false,\n  clearAriaLabel,\n  isFetching = false,\n  onRefresh,\n  sortAriaLabel,\n  sortTooltip,\n  sortDisabled = false,\n  sortMenu,\n  className,\n}: DatabaseSidebarTableSearchProps) {\n  const t = useT()\n  const resolvedAriaLabel = ariaLabel ?? placeholder\n  const resolvedClearLabel = clearAriaLabel ?? t('Clear table search')\n  const resolvedSortTooltip = sortTooltip ?? sortAriaLabel\n  const resolvedRefreshLabel = t('Refresh')\n  const hasClearButton = value.length > 0\n  const trailingActionCount = 2 + (hasClearButton ? 1 : 0)\n\n  return (\n    <div className={cn('relative min-w-0 flex-1', className)}>\n      <Search className=\"pointer-events-none absolute start-2.5 top-1/2 h-3 w-3 -translate-y-1/2 text-muted-foreground\" />\n      <Input\n        type=\"text\"\n        value={value}\n        onChange={(event) => onChange(event.target.value)}\n        placeholder={placeholder}\n        className={cn(\n          'h-8 ps-8 text-[13px]',\n          trailingActionCount === 3 ? 'pe-[4.5rem]' : 'pe-[3.25rem]',\n        )}\n        aria-label={resolvedAriaLabel}\n        disabled={disabled}\n      />\n      <div className=\"absolute end-0.5 top-1/2 flex -translate-y-1/2 items-center\">\n        <TooltipProvider delayDuration={0}>\n          {hasClearButton ? (\n            <Tooltip>\n              <TooltipTrigger asChild>\n                <Button\n                  type=\"button\"\n                  variant=\"ghost\"\n                  size=\"icon\"\n                  className=\"h-6 w-6 text-muted-foreground\"\n                  aria-label={resolvedClearLabel}\n                  onClick={() => onChange('')}\n                  disabled={disabled}\n                >\n                  <X className=\"h-3 w-3\" />\n                </Button>\n              </TooltipTrigger>\n              <TooltipContent side=\"top\" className=\"text-xs\">\n                {resolvedClearLabel}\n              </TooltipContent>\n            </Tooltip>\n          ) : null}\n          <DropdownMenu>\n            <Tooltip>\n              <TooltipTrigger asChild>\n                <DropdownMenuTrigger asChild>\n                  <Button\n                    type=\"button\"\n                    variant=\"ghost\"\n                    size=\"icon\"\n                    className=\"h-6 w-6 text-muted-foreground\"\n                    aria-label={sortAriaLabel}\n                    disabled={disabled || sortDisabled}\n                  >\n                    <ArrowUpDown className=\"h-3 w-3\" />\n                  </Button>\n                </DropdownMenuTrigger>\n              </TooltipTrigger>\n              <TooltipContent side=\"top\" className=\"text-xs\">\n                {resolvedSortTooltip}\n              </TooltipContent>\n            </Tooltip>\n            {sortMenu}\n          </DropdownMenu>\n          {onRefresh ? (\n            <Tooltip>\n              <TooltipTrigger asChild>\n                <Button\n                  type=\"button\"\n                  variant=\"ghost\"\n                  size=\"icon\"\n                  className=\"h-6 w-6 text-muted-foreground\"\n                  aria-label={resolvedRefreshLabel}\n                  onClick={onRefresh}\n                  disabled={disabled || isFetching}\n                >\n                  <RefreshCw\n                    className={cn(\n                      'h-3 w-3',\n                      isFetching && 'animate-spin',\n                    )}\n                  />\n                </Button>\n              </TooltipTrigger>\n              <TooltipContent side=\"top\" className=\"text-xs\">\n                {resolvedRefreshLabel}\n              </TooltipContent>\n            </Tooltip>\n          ) : null}\n        </TooltipProvider>\n      </div>\n    </div>\n  )\n}\n"],"mappings":"8NAiCA,SAAgB,EAA2B,CACzC,QACA,WACA,cACA,YACA,WAAW,GACX,iBACA,aAAa,GACb,YACA,gBACA,cACA,eAAe,GACf,WACA,aACkC,CAClC,IAAM,EAAI,GAAM,CACV,EAAoB,GAAa,EACjC,EAAqB,GAAkB,EAAE,qBAAqB,CAC9D,EAAsB,GAAe,EACrC,EAAuB,EAAE,UAAU,CACnC,EAAiB,EAAM,OAAS,EAChC,EAAsB,GAAK,EAAiB,EAAI,GAEtD,OACE,EAAA,EAAA,MAAC,MAAA,CAAI,UAAW,EAAG,0BAA2B,EAAU,YACtD,EAAA,EAAA,KAAC,EAAA,CAAO,UAAU,gGAAA,CAAkG,EACpH,EAAA,EAAA,KAAC,EAAA,CACC,KAAK,OACE,QACP,SAAW,GAAU,EAAS,EAAM,OAAO,MAAM,CACpC,cACb,UAAW,EACT,uBACA,IAAwB,EAAI,cAAgB,eAC7C,CACD,aAAY,EACF,YACV,EACF,EAAA,EAAA,KAAC,MAAA,CAAI,UAAU,wEACb,EAAA,EAAA,MAAC,EAAA,CAAgB,cAAe,YAC7B,GACC,EAAA,EAAA,MAAC,EAAA,CAAA,SAAA,EACC,EAAA,EAAA,KAAC,EAAA,CAAe,QAAA,aACd,EAAA,EAAA,KAAC,EAAA,CACC,KAAK,SACL,QAAQ,QACR,KAAK,OACL,UAAU,gCACV,aAAY,EACZ,YAAe,EAAS,GAAG,CACjB,qBAEV,EAAA,EAAA,KAAC,EAAA,CAAE,UAAU,UAAA,CAAY,EAClB,EACM,EACjB,EAAA,EAAA,KAAC,EAAA,CAAe,KAAK,MAAM,UAAU,mBAClC,GACc,CAAA,CAAA,CACT,CACR,MACJ,EAAA,EAAA,MAAC,EAAA,CAAA,SAAA,EACC,EAAA,EAAA,MAAC,EAAA,CAAA,SAAA,EACC,EAAA,EAAA,KAAC,EAAA,CAAe,QAAA,aACd,EAAA,EAAA,KAAC,EAAA,