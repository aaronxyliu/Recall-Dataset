{
  "schema": "recall.no-duplicate-library-policy/v1",
  "scope": "repository-library-instance",
  "inspectAllCapturedRuntimeAssets": true,
  "excludeConfirmedDuplicateLibraries": true,
  "excludeUnassessedLibrariesFromScoring": true,
  "newReplacementsRequireUniqueObservedModuleCode": true,
  "retainExistingUnobservedZeroPairLibraries": true,
  "unobservedLibrariesContributeNoEvaluationPairs": true,
  "sourceFunctionThresholdUnchanged": true,
  "requireInitialAnchors": false,
  "minimumLibrariesPerRepository": 3,
  "maximumLibrariesPerRepository": 10
}
